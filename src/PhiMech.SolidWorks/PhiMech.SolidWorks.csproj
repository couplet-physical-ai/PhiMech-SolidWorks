<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows .NET Framework COM add-in. Stub builds are compile-only, never deployable. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PhiMech.SolidWorks</RootNamespace>
    <AssemblyName>PhiMech.SolidWorks</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.3.0</Version>
    <Company>Project contributors</Company>
    <Product>PhiMech SolidWorks add-in</Product>
    <Copyright>See NOTICE</Copyright>
    <Description>STEP AP214 and design-IR exchange with optional local printing.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RegisterForComInterop>false</RegisterForComInterop>
    <PhiMechContractVersion>1</PhiMechContractVersion>
    <!-- Explicit API dir always wins. Stub fallback requires both an unset API dir and stub source. -->
  </PropertyGroup>
  <Target Name="RequireSolidWorksInterop" BeforeTargets="ResolveReferences"
          Condition="('$(SolidWorksApiDir)' == '' And !Exists('$(MSBuildThisFileDirectory)..\..\stubs\SolidWorks.Interop.Stubs\SolidWorks.Interop.Stubs.csproj')) Or ('$(SolidWorksApiDir)' != '' And (!Exists('$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll') Or !Exists('$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll') Or !Exists('$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll')))">
    <Error Text="Supply all three SolidWorks interop assemblies in SolidWorksApiDir or build against the separate compile-only stubs directory." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="PhiMechContractVersion" Value="$(PhiMechContractVersion)" />
    <AssemblyMetadata Include="PhiMechBuildKind" Value="stub" Condition="'$(SolidWorksApiDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\stubs\SolidWorks.Interop.Stubs\SolidWorks.Interop.Stubs.csproj')" />
    <AssemblyMetadata Include="PhiMechBuildKind" Value="real-interop" Condition="'$(SolidWorksApiDir)' != ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(SolidWorksApiDir)' != ''">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(SolidWorksApiDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\stubs\SolidWorks.Interop.Stubs\SolidWorks.Interop.Stubs.csproj')">
    <ProjectReference Include="..\..\stubs\SolidWorks.Interop.Stubs\SolidWorks.Interop.Stubs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <None Include="..\..\contracts\design-ir.schema.json" Link="contracts\design-ir.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\icons\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
