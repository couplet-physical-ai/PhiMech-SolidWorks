<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COMPILE-ONLY stubs of the SolidWorks interop surface this add-in touches.

    They exist so CI (which has no SolidWorks licence and therefore no
    SolidWorks.Interop.*.dll) can prove the add-in compiles. They contain interfaces, enum names and placeholder values, not behavior. A build
    against these proves nothing about SolidWorks; runtime behavior needs a licensed seat.

    Rules: add a member here only when the add-in starts using it; keep the signature identical
    to the real interop (name, parameter order, ref/out); never add behaviour. If a signature
    here turns out to be wrong against the real DLL, the real DLL wins - fix the stub.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SolidWorks.Interop.Stubs</AssemblyName>
    <RootNamespace>SolidWorks.Interop</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Match the host for pure net8.0 tests; Windows deployment remains x64. -->
    <PlatformTarget Condition="'$(OS)' != 'Windows_NT'">AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
